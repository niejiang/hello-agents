LLM_MODEL_ID=your_model_id
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=180
# 上下文限制（以下为 qwen3.7-plus 华北2 北京、非思考模式的取值；更换模型时按百炼模型列表修改）
# 模型最大输入长度，作为硬上限兜底
LLM_MAX_INPUT_TOKENS=991808
# 实际工作预算（输入 Token），超过 256K 单价翻 3 倍，因此留在其下方
LLM_CONTEXT_BUDGET=128000
