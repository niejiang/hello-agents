# 模型配置示例。复制为 .env 后填写密钥；.env 与 .env.* 均已加入 Git 忽略规则（本文件除外）。
# 对比其他模型服务时，另建一个配置文件（如 .env.deepseek），启动时用 CODECHAT_ENV_FILE=.env.deepseek
# 或命令行参数 --env-file .env.deepseek 指定，见 README“切换模型服务”。

# 当前默认：千问 qwen3.7-plus（阿里云百炼，华北2 北京）
LLM_MODEL_ID=qwen3.7-plus
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=180
# 随请求发送的模型服务专有参数（JSON 对象）。qwen3.7-plus 默认开启思考，此处关闭；本项目不回传思考内容，请保持关闭
LLM_EXTRA_BODY={"enable_thinking": false}
# 模型最大输入长度，作为硬上限兜底（qwen3.7-plus 非思考模式为 991808）
LLM_MAX_INPUT_TOKENS=991808
# 实际工作预算（输入 Token）：工具循环每轮重发整个上下文，按输入量计费。
# qwen3.7-plus 输入不超过 256K 时为第一档（输入 2 元、输出 8 元/百万 Token，隐式缓存命中按输入价 20%），128K 预算始终处于第一档
LLM_CONTEXT_BUDGET=128000

# ---- DeepSeek 示例（另存为 .env.deepseek，取消注释并填写密钥）----
# LLM_MODEL_ID=deepseek-v4-pro
# LLM_API_KEY=your_deepseek_api_key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=180
# # DeepSeek 默认开启思考；开启时带工具的请求必须回传 reasoning_content，本项目未实现，因此关闭
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
# # 官方页面给出上下文 1M、最大输出 384K，此处按 1,000,000 − 393,216 估算
# LLM_MAX_INPUT_TOKENS=606784
# LLM_CONTEXT_BUDGET=128000
