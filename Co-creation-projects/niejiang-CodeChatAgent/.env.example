LLM_MODEL_ID=qwen4-max
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=180
# 上下文限制（以下为 qwen4-max 华北2 北京、非思考模式的取值；更换模型时按百炼模型列表修改）
# 模型最大输入长度，作为硬上限兜底
LLM_MAX_INPUT_TOKENS=991808
# 实际工作预算（输入 Token）：工具循环每轮重发整个上下文，按输入量计费，控制在 128K 以内兼顾成本与延迟
LLM_CONTEXT_BUDGET=128000
